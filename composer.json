{
    "name": "pigeonexpress/php-sdk",
    "description": "Official PHP SDK for Pigeon Express Courier API",
    "version": "1.2.0",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "pigeon-express",
        "courier",
        "shipping",
        "delivery",
        "sdk",
        "api"
    ],
    "authors": [
        {
            "name": "Pigeon Express",
            "email": "dev@pigeonexpress.bg"
        }
    ],
    "require": {
        "php": ">=7.3",
        "guzzlehttp/guzzle": "^6.5 || ^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "PigeonExpress\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PigeonExpress\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
